# ==========================================
# CH|ORIGIN Discord Bot & Bridge Configuration
# ==========================================
# Copy this file to .env and fill in your values

# Discord Bot Credentials
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here

# Channel where store purchase announcements will be posted
DISCORD_PURCHASE_CHANNEL_ID=your_channel_id_here

# API Server Port
API_PORT=3001

# Shared secret key (CHANGE THIS — use a long random string)
API_SECRET_KEY=chorigin_super_secret_bridge_key_12345

# Role Mappings: package_id -> Discord Role ID (JSON)
ROLE_MAPPINGS={"vip":"DISCORD_ROLE_ID_VIP","mvp":"DISCORD_ROLE_ID_MVP","titan":"DISCORD_ROLE_ID_TITAN"}
