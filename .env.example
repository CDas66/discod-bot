# =================================================================
# CH|ORIGIN Discord Bot & Bridge Configuration (Local & Global)
# =================================================================

# ── Discord Bot Credentials ─────────────────────────────────────
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here

# Channel where store purchase announcements will be posted
DISCORD_PURCHASE_CHANNEL_ID=your_channel_id_here

# ── API Server Port & Security ──────────────────────────────────
# On cloud hosting (Railway, Render, Heroku), PORT is set automatically.
# When running locally or on a VPS, it defaults to 3001.
PORT=3001
API_PORT=3001

# Shared secret key between Webstore, Discord Bot, and Minecraft Plugin.
# Use a strong, random password in production!
API_SECRET_KEY=chorigin_super_secret_bridge_key_12345

# Allowed CORS origins for the Webstore (comma-separated, or * for all)
# e.g.: https://ch-origin.web.app,https://ch-origin.firebaseapp.com,https://store.yourdomain.com
ALLOWED_ORIGINS=*

# Optional: Custom SQLite path (e.g., for persistent volume mounts)
# DATA_DIR=/app/data
# DATABASE_PATH=/app/data/bridge.db

# ── Role Mappings ───────────────────────────────────────────────
# Maps store package_id -> Discord Role ID (JSON format)
ROLE_MAPPINGS={"vip":"DISCORD_ROLE_ID_VIP","mvp":"DISCORD_ROLE_ID_MVP","titan":"DISCORD_ROLE_ID_TITAN"}
